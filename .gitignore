!**/.env.*.example
**/.env.local
**/.aws/
**/.ssh/
**/.config/gcloud/
**/*credentials*
**/*secrets*.json
**/*token*.json
*.pem
*.key
*.p12
*.pfx
*.crt
credentials*.json
**/credentials*.json
**/*service-account*.json

# Python environments and generated bytecode
venv/
.venv/
env/
ENV/
backend/venv/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# Node and Next.js outputs
**/node_modules/
frontend/.next/
frontend/out/
frontend/.vercel/
frontend/.turbo/
frontend/tsconfig.tsbuildinfo

# Logs, editor files, and temporary work
*.log
logs/
*.tmp
*.temp
*.part
*.partial
*.download
tmp/
temp/
.cache/
**/staging/
**/cache/
**/*_cache/
.vscode/
.idea/
.DS_Store
Thumbs.db

# Raw source weather data, downloaded forecast caches, and generated training data
data/raw/
data/processed/
data/sample/
backend/data/sample/

# Keep only compact production district geometry and its provenance metadata.
# The 114+ MiB full-resolution source stays local and is never pushed to GitHub.
data/geospatial/source/
data/geospatial/india_districts.geojson

# Generated scientific outputs are local by default. These compact frozen
# verification artifacts are deliberately versioned for the public API/README.
data/results/*
!data/results/test_metrics.csv
!data/results/threshold_metrics.csv
!data/results/regime_metrics.csv
!data/results/scientific_metrics.json
!data/results/experiment_manifest.json
!data/results/phase3f_frozen_models.json

# Keep only the production Phase 3F inference bundle from this large model tree.
models/scientific/*
!models/scientific/phase3f/
!models/scientific/phase3f/**

# Duplicate backend model cache; runtime code imports the root ml/ package.
backend/ml/

# Experiment trackers and generated artifacts
wandb/
mlruns/
*.h5
*.pkl
*.pt
*.onnx

# Preserve intentionally empty directories when present.
!.gitkeep
