# Optional server-side Next.js rewrite target. Leave NEXT_PUBLIC_API_URL unset
# locally so browser requests use same-origin /api through the Next proxy.
ANVAYA_BACKEND_ORIGIN=http://127.0.0.1:8000
# Render: set NEXT_PUBLIC_API_URL to the deployed FastAPI origin (without /api).
# Google Maps is not required. MapLibre/OpenFreeMap and Open-Meteo are keyless.
